{
  "expo": {
    "name": "Tech Lab",
    "slug": "tech-lab-app",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F1EFFD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucasrs.lojaturmaapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.lucasrs.lojaturmaapp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
